rules_version = '2';

// Regras de segurança do Firestore para o sistema Gestão Integrada RH.
// Cole este conteúdo em: Firebase Console -> Firestore Database -> Regras.
//
// Lógica de proteção (Fase 2 - empresas e usuários):
// - Qualquer pessoa pode LER a lista de empresas (necessário para a tela
//   de cadastro, onde um candidato escolhe a empresa antes mesmo de criar
//   conta). Nenhum dado sensível fica nesse documento.
// - Só uma pessoa autenticada pode CRIAR uma nova empresa.
// - Só o próprio usuário (RH Admin ou Colaborador) pode ler/alterar o seu
//   próprio cadastro, OU um RH Admin da mesma empresa pode ler/alterar
//   qualquer cadastro dela.
// - Os demais dados (holerites, ponto, atestados, faltas, documentos de
//   admissão) continuam apenas no navegador nesta fase e não têm regra
//   aqui ainda.

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function ehRhAdminDaEmpresa(empresaId) {
      return estaLogado() &&
        exists(/databases/$(database)/documents/empresas/$(empresaId)/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/empresas/$(empresaId)/usuarios/$(request.auth.uid)).data.perfil == 'RH_ADMIN';
    }

    match /empresas/{empresaId} {
      allow read: if true;
      allow create: if estaLogado();
      allow update, delete: if ehRhAdminDaEmpresa(empresaId);

      match /usuarios/{usuarioId} {
        allow read, create, update: if estaLogado() &&
          (request.auth.uid == usuarioId || ehRhAdminDaEmpresa(empresaId));
        allow delete: if ehRhAdminDaEmpresa(empresaId);
      }
    }
  }
}
